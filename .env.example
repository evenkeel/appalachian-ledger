# No application password is hardcoded. Create the local owner in the browser.
BIND_ADDRESS=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
TZ=America/New_York
# Opt in, then choose "Load fictional demo" on an empty installation.
DEMO_ENABLED=false
# Optional read-only Bitcoin Core RPC. Never expose RPC publicly.
BITCOIN_RPC_HOST=
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# Optional CoinGecko demo API key. Manual/offline mode is the default.
COINGECKO_API_KEY=

# Price worker runs only when a provider is selected and automatic updates or an explicit sync is requested.
PRICE_WORKER_ENABLED=true
